{
  "name": "dftp",
  "version": "0.1.0",
  "description": "DFTP (Designer for the Page): a drag-and-drop layout designer for almost any web page",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dftp": "bin/dftp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "server/",
    "client/",
    "layer/",
    "demo/",
    "plugins/",
    "skills/",
    "README.md",
    "CLAUDE.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/dftp.mjs",
    "demo": "node bin/dftp.mjs --demo --open",
    "test": "npm run test:unit && npm run test:security && npm run test:e2e",
    "test:unit": "node --import ./test/no-net.mjs --test --test-concurrency=4 \"test/unit/*.test.mjs\"",
    "test:security": "node --import ./test/no-net.mjs --test --test-concurrency=4 \"test/security/*.test.mjs\"",
    "test:e2e": "playwright test --pass-with-no-tests",
    "lint": "eslint .",
    "hygiene": "node scripts/hygiene.mjs",
    "skill": "node scripts/build-skill.mjs",
    "check": "npm run lint && npm run hygiene && npm test"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
